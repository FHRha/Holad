# ==========================================
# Holad Docker Environment Configuration
# ==========================================

# Port the internal server listens on (default: 4000)
PORT=4000

# User ID and Group ID for file permission management on Linux (default: 1000)
PUID=1000
PGID=1000

# Path to the SQLite database file inside the container
DATABASE_PATH=/data/holad.sqlite

# Web client base path (default: /Holad/).
# Set to / if you are hosting Holad on the root of a domain/subdomain (e.g. https://music.example.com/)
BASE_PATH=/Holad/

# Master encryption key (AES-256-GCM) for encrypting Navidrome tokens and account data in SQLite.
# If left commented or empty, Holad will automatically generate a secure persistent key
# and store it in /data/.encryption_key inside your persistent volume.
# ENCRYPTION_KEY=my_secure_random_hex_key_32_bytes

# ==========================================
# Automated SQLite Online Backup Settings
# ==========================================
# Set to 'true' to enable automated non-blocking SQLite backups
BACKUP_ENABLED=false

# Directory where backups will be stored (relative to container)
BACKUP_PATH=/data/backups

# Frequency of backups in hours (default: 24)
BACKUP_INTERVAL_HOURS=24

# Number of days to keep backup files before automated cleanup (default: 7)
BACKUP_RETENTION_DAYS=7

# ==========================================
# Optional Headless Server Auto-Configuration
# ==========================================
# If configured, Holad automatically imports this account on initial startup
# NAVIDROME_URL=https://music.example.com
# NAVIDROME_USER=admin
# NAVIDROME_PASS=secretpassword

# ==========================================
# Managed Demo Mode Configuration (Optional)
# ==========================================
# Enable public interactive demo mode with automatic guest slot pool
# DEMO_MODE=false
# Maximum concurrent demo guest slots (default: 25)
# DEMO_POOL_SIZE=25
# Lease duration in minutes for active demo sessions (default: 30)
# DEMO_SESSION_MINUTES=30
