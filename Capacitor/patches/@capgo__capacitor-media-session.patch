 import com.getcapacitor.JSObject;
 
 public class MediaSessionCallback extends MediaSessionCompat.Callback {
 
     private final MediaSessionPlugin plugin;
+    private long lastMediaButtonTime = 0L;
+    private static final long DEBOUNCE_DELAY_MS = 250L;
 
     MediaSessionCallback(MediaSessionPlugin plugin) {
         this.plugin = plugin;
     }
 
+    private boolean isBluetoothConnecting() {
+        try {
+            Class<?> clazz = Class.forName("com.holad.app.AudioDevicePlugin");
+            java.lang.reflect.Method method = clazz.getMethod("isBluetoothConnecting");
+            Object result = method.invoke(null);
+            if (result instanceof Boolean) {
+                return (Boolean) result;
+            }
+        } catch (Throwable ignored) {}
+        return false;
+    }
+
+    @Override
+    public boolean onMediaButtonEvent(Intent mediaButtonIntent) {
+        if (mediaButtonIntent == null) {
+            return super.onMediaButtonEvent(null);
+        }
+
+        KeyEvent keyEvent = null;
+        try {
+            if (Build.VERSION.SDK_INT >= Build.VERSION_CODES.TIRAMISU) {
+                keyEvent = mediaButtonIntent.getParcelableExtra(Intent.EXTRA_KEY_EVENT, KeyEvent.class);
+            } else {
+                keyEvent = mediaButtonIntent.getParcelableExtra(Intent.EXTRA_KEY_EVENT);
+            }
+        } catch (Throwable t) {
+            try {
+                keyEvent = mediaButtonIntent.getParcelableExtra(Intent.EXTRA_KEY_EVENT);
+            } catch (Throwable ignored) {}
+        }
+
+        if (keyEvent == null) {
+            return super.onMediaButtonEvent(mediaButtonIntent);
+        }
+
+        int keyCode = keyEvent.getKeyCode();
+
+        // Pass through next and previous to super.onMediaButtonEvent
+        if (keyCode == KeyEvent.KEYCODE_MEDIA_NEXT || keyCode == KeyEvent.KEYCODE_MEDIA_PREVIOUS) {
+            return super.onMediaButtonEvent(mediaButtonIntent);
+        }
+
+        // Only handle on ACTION_DOWN; consume ACTION_UP for handled keys to prevent super from processing
+        if (keyEvent.getAction() != KeyEvent.ACTION_DOWN) {
+            if (keyCode == KeyEvent.KEYCODE_MEDIA_PLAY_PAUSE ||
+                keyCode == KeyEvent.KEYCODE_HEADSETHOOK ||
+                keyCode == KeyEvent.KEYCODE_MEDIA_PLAY ||
+                keyCode == KeyEvent.KEYCODE_MEDIA_PAUSE) {
+                return true;
+            }
+            return super.onMediaButtonEvent(mediaButtonIntent);
+        }
+
+        long now = SystemClock.uptimeMillis();
+
+        if (keyCode == KeyEvent.KEYCODE_MEDIA_PLAY_PAUSE || keyCode == KeyEvent.KEYCODE_HEADSETHOOK) {
+            if (now - lastMediaButtonTime >= DEBOUNCE_DELAY_MS) {
+                lastMediaButtonTime = now;
+                // STRICTLY PREVENT legacy Android mIsDoubleTapPending which converts quick clicks to onSkipToNext().
+                plugin.actionCallback("playpause");
+            }
+            return true;
+        } else if (keyCode == KeyEvent.KEYCODE_MEDIA_PLAY) {
+            if (now - lastMediaButtonTime >= DEBOUNCE_DELAY_MS) {
+                lastMediaButtonTime = now;
+                if (isBluetoothConnecting()) {
+                    Log.i("CapgoMediaSession", "Dropped KEYCODE_MEDIA_PLAY during Bluetooth connection grace period");
+                } else {
+                    onPlay();
+                }
+            }
+            return true;
+        } else if (keyCode == KeyEvent.KEYCODE_MEDIA_PAUSE) {
+            if (now - lastMediaButtonTime >= DEBOUNCE_DELAY_MS) {
+                lastMediaButtonTime = now;
+                onPause();
+            }
+            return true;
+        }
+
+        return super.onMediaButtonEvent(mediaButtonIntent);
+    }
+
     @Override
     public void onPlay() {
+        if (isBluetoothConnecting()) {
+            Log.i("CapgoMediaSession", "Dropped KEYCODE_MEDIA_PLAY during Bluetooth connection grace period");
+            return;
+        }
         plugin.actionCallback("play");
     }
 
