+    private void acquirePauseWakeLock() {
+        try {
+            if (pauseWakeLock == null) {
+                PowerManager pm = (PowerManager) getSystemService(Context.POWER_SERVICE);
+                if (pm != null) {
+                    pauseWakeLock = pm.newWakeLock(PowerManager.PARTIAL_WAKE_LOCK, "Holad:MediaSessionPauseWakeLock");
+                    pauseWakeLock.setReferenceCounted(false);
+                }
+            }
+            if (pauseWakeLock != null) {
+                pauseWakeLock.acquire(45000L);
+                Log.d(TAG, "Acquired partial WakeLock for 45s during playback pause");
+            }
+        } catch (Exception e) {
+            Log.w(TAG, "Failed to acquire pause WakeLock", e);
+        }
+    }
+
+    private void releasePauseWakeLock() {
+        try {
+            if (pauseWakeLock != null && pauseWakeLock.isHeld()) {
+                pauseWakeLock.release();
+                Log.d(TAG, "Released pause WakeLock");
+            }
+        } catch (Exception e) {
+            Log.w(TAG, "Failed to release pause WakeLock", e);
+        }
+    }
+
     public void destroy() {
+        releasePauseWakeLock();
         stopForeground(true);
         stopSelf();
     }
 
