{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Holad",
  "version": "2.0.5",
  "identifier": "com.holad.desktop",
  "build": {
    "frontendDist": "../../client/dist",
    "devUrl": "http://localhost:4000",
    "beforeDevCommand": "",
    "beforeBuildCommand": ""
  },
  "app": {
    "windows": [
      {
        "label": "main",
        "title": "Holad",
        "visible": false,
        "width": 1280,
        "height": 720,
        "resizable": true,
        "fullscreen": false,
        "maximized": true,
        "theme": "Dark",
        "userAgent": "Holad-Desktop",
        "backgroundColor": [
          18,
          18,
          18,
          255
        ]
      },
      {
        "label": "tray_menu",
        "title": "Holad (Tray Menu)",
        "url": "/#tray",
        "visible": false,
        "decorations": false,
        "transparent": true,
        "alwaysOnTop": true,
        "skipTaskbar": true,
        "width": 320,
        "height": 450,
        "resizable": false,
        "backgroundColor": [0, 0, 0, 0]
      }
    ],
    "security": {
      "csp": "default-src 'self' tauri: asset: http://asset.localhost; img-src 'self' tauri: asset: http://asset.localhost http: https: data: blob:; media-src 'self' tauri: asset: http://asset.localhost http: https: blob:; connect-src 'self' tauri: http: https: ws: wss:; style-src 'self' 'unsafe-inline' https://fonts.googleapis.com; font-src 'self' data: https://fonts.gstatic.com; script-src 'self';",
      "assetProtocol": {
        "enable": true,
        "scope": [
          "$DOWNLOAD/Holad/**",
          "$APPDATA/com.holad.desktop/**",
          "$APPDATA/Holad/**",
          "$TEMP/holad_icons/**"
        ]
      }
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "android": {
      "debugApplicationIdSuffix": ".debug"
    },
    "resources": [
      "icons/taskbar/*"
    ]
  },
  "plugins": {
    "deep-link": {
      "desktop": {
        "schemes": ["holad"]
      }
    },
    "shell": {
      "open": "^https?://.*"
    },
    "updater": {
      "endpoints": [
        "https://api.github.com/repos/FHRha/Holad/releases/latest"
      ],
      "pubkey": "dW50cnVzdGVkIGNvbW1lbnQ6IG1pbmlzaWduIHB1YmxpYyBrZXk6IEYxNzM2MUQxQTE1MkI1NDgKUldSSXRWS2gwV0Z6OFdRUVUyelFWeDVqS3ZGYjRRUytwZVZtTDZCMUZFOVBzY25vN2JHNDZhUjAK"
    }
  }
}