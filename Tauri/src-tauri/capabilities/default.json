{
  "$schema": "../gen/schemas/desktop-schema.json",
  "identifier": "default",
  "description": "enables the default permissions",
  "windows": [
    "main",
    "tray_menu"
  ],
  "permissions": [
    "core:default",
    "fs:default",
    "dialog:default",
    "shell:default",
    {
      "identifier": "shell:allow-open",
      "allow": [
        {
          "regex": ".*"
        }
      ]
    },
    "core:path:default"
  ]
}