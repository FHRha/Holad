{
  "identifier": "fs-access",
  "windows": [
    "main"
  ],
  "permissions": [
    "fs:default",
    "fs:allow-exists",
    "fs:allow-mkdir",
    "fs:allow-read-dir",
    "fs:allow-read-file",
    "fs:allow-remove",
    "fs:allow-write-file",
    "fs:allow-copy-file",
    "fs:allow-rename",
    {
      "identifier": "fs:scope",
      "allow": [
        { "path": "$DOWNLOAD/Holad/**" },
        { "path": "$APPDATA/com.holad.desktop/**" },
        { "path": "$APPDATA/Holad/**" },
        { "path": "$TEMP/holad_icons/**" }
      ]
    }
  ]
}
