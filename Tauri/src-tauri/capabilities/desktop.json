{
  "$schema": "../gen/schemas/desktop-schema.json",
  "identifier": "desktop",
  "description": "enables desktop-only plugin permissions",
  "platforms": [
    "linux",
    "macOS",
    "windows"
  ],
  "windows": [
    "main",
    "tray_menu"
  ],
  "permissions": [
    "autostart:default",
    "deep-link:default",
